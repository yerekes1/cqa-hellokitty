# Основная бесплатная модель для чатов
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
FALLBACK_MODELS=
GEMINI_API_KEY=

# Звонки: реальные данные, поэтому они не идут в бесплатный облачный тариф.
# ollama = локально на вашем компьютере. skip = пометить status="error" с причиной.
VOICE_PROVIDER=ollama
VOICE_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

TEAM_NAME=Название команды

# Адрес кнопки GET из гайда, без group_id
ORGANIZER_API_URL=
